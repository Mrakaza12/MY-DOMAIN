# Copy this file to `.env.local` for local development.
#
# Leave DATABASE_URL empty to use the built-in PGlite database (no server
# needed — data is kept in ./.data/pglite). In production this variable is
# required and must point at a real Postgres instance, e.g. Neon:
#   postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Optional: the name shown in the header and page titles.
NEXT_PUBLIC_SITE_NAME=Keyline
